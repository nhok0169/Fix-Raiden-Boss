        <argsstring>(TextureFile &amp;texFile, int alpha)</argsstring>
        <name>setTransparency</name>
        <qualifiedname>AGRemapCore::TexEditor::setTransparency</qualifiedname>
        <param>
          <type><ref refid="class_a_g_remap_core_1_1_texture_file" kindref="compound">TextureFile</ref> &amp;</type>
